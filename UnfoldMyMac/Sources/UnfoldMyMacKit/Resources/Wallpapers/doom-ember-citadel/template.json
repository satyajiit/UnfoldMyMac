  "metadata": {
    "version": 1,
    "collection": "wallpapers",
    "overview": "The citadel heats up with the thermal pressure reported by macOS. Three armor cells show the pressure level, and CPU and memory usage stay visible below. Serious or critical pressure brings a practical cooling reminder. These are system pressure states, not invented temperature readings.",
    "badge": "New",
    "banner": "Official",
    "sections": [
      {
        "title": "Thermal armor",
        "body": "The citadel heats up with the thermal pressure reported by macOS. Three armor cells show the pressure level, and CPU and memory usage stay visible below. Serious or critical pressure brings a practical cooling reminder. These are system pressure states, not invented temperature readings."
      },
      {
        "title": "Built for your desktop",
        "body": "Live readings stay readable with Reduce Motion. The lid dims the scene and the pointer adds subtle depth. Settings changes are saved per wallpaper."
      },
