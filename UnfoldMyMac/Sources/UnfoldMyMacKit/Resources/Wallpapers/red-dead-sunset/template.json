  "metadata": {
    "version": 1,
    "collection": "wallpapers",
    "overview": "Your chosen city’s clock, sunrise, sunset and countdown to the next solar event sit beside a sun that travels along the horizon arc. The scene dims at night. Times use the selected city’s timezone, including daylight-saving changes. Solar data comes from Open-Meteo.",
    "badge": "New",
    "banner": "Official",
    "sections": [
      {
        "title": "Daylight companion",
        "body": "Your chosen city’s clock, sunrise, sunset and countdown to the next solar event sit beside a sun that travels along the horizon arc. The scene dims at night. Times use the selected city’s timezone, including daylight-saving changes. Solar data comes from Open-Meteo."
      },
      {
        "title": "Built for your desktop",
        "body": "Live readings stay readable with Reduce Motion. The lid dims the scene and the pointer adds subtle depth. Settings changes are saved per wallpaper."
      },
      {
        "title": "Weather & city data",
        "body": "Forecasts by Open-Meteo (CC BY 4.0); city names by GeoNames. Cached readings show their update time and expire after two hours. No precise device location is requested."
      },
      {
        "title": "Artwork & attribution",
