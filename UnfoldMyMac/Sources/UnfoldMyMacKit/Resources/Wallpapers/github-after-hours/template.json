  "metadata": {
    "version": 1,
    "collection": "wallpapers",
    "overview": "Your public GitHub profile becomes a floating city. A little celebration of repositories, community, and the work you share.",
    "sections": [
      {
        "title": "Connect a public profile",
        "body": "Enter a GitHub username in Customize. The scene reads **public profile data through GitHub’s API**; no access token or private-repository access is needed."
      },
      {
        "title": "A changing desktop",
        "body": "The composition follows the available public data. Network availability and API limits can affect freshness; the design keeps its visual character between updates."
      }
